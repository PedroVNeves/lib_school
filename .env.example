SECRET_KEY=change-me-generate-a-new-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Produção (Cloud Run) ---
# Deixe tudo abaixo vazio/comentado para rodar local (usa SQLite + e-mail no console).

# Obrigatório em produção: string de conexão do Postgres (ex: Neon).
# DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Obrigatório em produção: domínio(s) reais, com https://, separados por vírgula.
# CSRF_TRUSTED_ORIGINS=https://sua-escola-xxxx.a.run.app

# Opcional: storage de mídia (fotos/capas/logos) em bucket S3-compatível (ex: Cloudflare R2).
# Sem isso, uploads ficam no disco local (some a cada deploy no Cloud Run).
# AWS_STORAGE_BUCKET_NAME=biblioteca-escolar-media
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=

# Opcional: envio real de e-mail (reset de senha) via SMTP (ex: Resend, Brevo).
# Sem isso, e-mails só aparecem no log do servidor.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Biblioteca Escolar <biblioteca@seudominio.com.br>
